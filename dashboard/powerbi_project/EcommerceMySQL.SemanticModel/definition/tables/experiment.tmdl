					{10.00, 34.9091, 38.400000, 3.490909, 2990, 5980},
					{20.00, 34.9091, 41.890909, 6.981818, 761, 1522},
					{30.00, 34.9091, 45.381818, 10.472727, 343, 686}
				})
			in
				Source
